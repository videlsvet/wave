<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🌐 Интернет и сеть -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ⚡ Foreground-сервис -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 🎵 Для Android 13+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 🎧 Для системных медиа-кнопок (Bluetooth, гарнитуры, авто) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <application
        android:name=".WaveApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Wave">

        <!-- 🚀 Экран авторизации (теперь стартовый экран) -->
        <activity
            android:name=".AuthActivity"
            android:exported="true"
            android:theme="@style/Theme.Wave.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🎧 Главный экран с плеером -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Wave.Splash" />

        <!-- 🎶 Медиа-сервис (управление плеером, Bluetooth и системными кнопками) -->
        <service
            android:name=".player.WaveMediaService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">

            <!-- 🎧 Обработка системных кнопок (Play/Pause/Next) -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>

            <!-- 🎵 Поддержка Android Auto, Bluetooth и системного плеера -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>

            <!-- ⚙️ Настройки сессии -->
            <meta-data
                android:name="android.media.session"
                android:resource="@xml/media_session" />
        </service>

    </application>

</manifest>
